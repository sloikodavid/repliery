{
	"name": "repliery",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "pnpm run --parallel \"/^dev:.+$/\"",
		"dev:next": "next dev",
		"dev:convex": "convex dev",
		"build": "next build",
		"start": "next start",
		"test": "vitest run",
		"check": "biome check --reporter=concise . && tsc --noEmit",
		"fix": "biome check --write .",
		"verify": "pnpm run check && pnpm run test && pnpm run build"
	},
	"dependencies": {
		"@clerk/backend": "3.16.7",
		"@clerk/nextjs": "7.7.7",
		"@clerk/ui": "1.30.4",
		"@tabler/icons-react": "^3.46.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"convex": "^1.44.0",
		"next": "16.3.1",
		"next-themes": "0.4.6",
		"react": "19.2.8",
		"react-aria-components": "^1.20.0",
		"react-dom": "19.2.8",
		"shadcn": "^4.18.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@edge-runtime/vm": "5.0.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"convex-test": "0.0.55",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vite": "8.2.1",
		"vitest": "4.1.11"
	},
	"packageManager": "pnpm@11.5.0"
}
