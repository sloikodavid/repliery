{
	"name": "repliery",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "pnpm run --parallel \"/^dev:.+$/\"",
		"dev:next": "next dev",
		"dev:convex": "convex dev",
		"build": "next build",
		"start": "next start",
		"check": "pnpm run --parallel \"/^check:[^:]+$/\"",
		"check:biome": "biome check --reporter=concise .",
		"check:types": "tsc --noEmit",
		"test": "pnpm run --parallel \"/^test:(unit|integration)$/\" && pnpm run test:e2e",
		"test:unit": "vitest run --project=unit",
		"test:integration": "pnpm run --parallel \"/^test:integration:[^:]+$/\"",
		"test:integration:convex": "pnpm run --parallel \"/^test:integration:convex:[^:]+$/\"",
		"test:integration:convex:mock": "vitest run --project=convex-mock",
		"test:integration:convex:local": "node test/support/integration/convex/local/run-with-local-backend.mjs integration",
		"test:e2e": "node test/support/integration/convex/local/run-with-local-backend.mjs e2e",
		"watch:test": "vitest --project=unit --project=convex-mock",
		"fix": "biome check --write .",
		"verify": "pnpm run --sequential \"/^(check|test)$/\" && pnpm run build"
	},
	"dependencies": {
		"@clerk/backend": "3.16.9",
		"@clerk/nextjs": "7.7.9",
		"@clerk/ui": "1.30.5",
		"@tabler/icons-react": "^3.46.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"convex": "^1.44.0",
		"next": "16.3.1",
		"next-themes": "0.4.6",
		"react": "19.2.8",
		"react-aria-components": "^1.20.0",
		"react-dom": "19.2.8",
		"shadcn": "^4.18.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@clerk/testing": "2.2.27",
		"@edge-runtime/vm": "5.0.0",
		"@playwright/test": "1.62.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "24.13.3",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"convex-test": "0.0.55",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vite": "8.2.1",
		"vitest": "4.1.11"
	},
	"packageManager": "pnpm@11.5.0"
}
